  "_exerciseAnalysisComment": "Pins analyzeExercise across the Dart (exercise_analysis.dart) and Node (exercise_analytics.js) engines. Both suites build sessions from the specs (sets are {reps, weight}; weight null = bodyweight) at `now` minus `daysAgo` days, run analyzeExercise, and assert `expect`. e1RM to 0.01 tolerance; changeSign is sign(percent) as -1/0/1. tags order is pinned too.",
  "exerciseAnalysis": [
    {
      "name": "40x7 beats 35x10 on estimated strength (the headline case)",
      "now": "2026-09-02T18:00:00",
      "exerciseId": "incline",
      "sessions": [
        {"id": "s_last", "daysAgo": 7, "sets": [{"reps": 8, "weight": 35}, {"reps": 10, "weight": 35}]},
        {"id": "s_this", "daysAgo": 1, "sets": [{"reps": 7, "weight": 40}, {"reps": 7, "weight": 40}, {"reps": 6, "weight": 37}]}
      ],
      "expect": {
        "totalSessions": 2,
        "status": "building",
        "isWeighted": true,
        "currentE1RM": 49.3333,
        "latest": {"topWeightKg": 40, "topReps": 7, "totalReps": 20, "totalVolumeKg": 782, "bestE1RM": 49.3333, "workingSetCount": 3, "isPrSession": true},
        "previous": {"topWeightKg": 35, "topReps": 10, "totalVolumeKg": 630, "bestE1RM": 46.6667},
        "latestComparison": {"tone": "improved", "loadChangeKg": 5, "topRepsChange": -3, "e1rmChangeSign": 1, "volumeChangeSign": 1, "tags": ["newPr", "strengthUp", "loadUp", "repsDown", "volumeUp"]}
      }
    },
    {
      "name": "lighter for far more volume = mixed (intensity down, volume up)",
      "now": "2026-09-02T18:00:00",
      "exerciseId": "squat",
      "sessions": [
