rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Email OTP records are written and read ONLY by the Cloud Functions
    // Admin SDK (which bypasses these rules). No client may ever read the
    // hashes, salts, or attempt counters — deny everything here.
    match /emailOtps/{uid} {
      allow read, write: if false;
    }

    // User profiles: each signed-in user may read and write ONLY their own
    // document. Name + date of birth captured at profile completion; the uid
    // is the doc id, so ownership is `request.auth.uid == userId`.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Tasks: each user reads/writes only their own tasks. Owner is the {userId}
    // path segment. Basic field validation on create/update. Rules do not
    // cascade from the parent /users/{userId} match, so this must be explicit.
    match /users/{userId}/tasks/{taskId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.data.title is string
        && request.resource.data.done is bool
        && request.resource.data.priority is bool
        && request.resource.data.schemaVersion is int;
    }

    // Expenses: each user reads/writes only their own expenses (append-only log).
    // Rules do not cascade from the parent /users/{userId} match, so this is explicit.
    match /users/{userId}/expenses/{expenseId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.amountMinor is int
        && request.resource.data.amountMinor >= 0
        && request.resource.data.currency is string
        && request.resource.data.category is string
        && request.resource.data.spentAt is timestamp
        && request.resource.data.schemaVersion is int;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Schedule: each user reads/writes only their own events.
    // Rules do not cascade from the parent /users/{userId} match, so this is explicit.
    match /users/{userId}/schedule/{eventId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.title is string
        && request.resource.data.start is timestamp
        && request.resource.data.schemaVersion is int;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Notes: each user reads/writes only their own notes.
    // Rules do not cascade from the parent /users/{userId} match, so this is explicit.
    match /users/{userId}/notes/{noteId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.body is string
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.schemaVersion is int;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Workouts: each user reads/writes only their own logged sessions
    // (exercises embedded). Rules do not cascade from /users/{userId}, so explicit.
    match /users/{userId}/workouts/{workoutId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.title is string
        && request.resource.data.performedAt is timestamp
        && request.resource.data.exercises is list
        && request.resource.data.schemaVersion is int;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Workout plans: each user reads/writes only their own plan(s) — the
    // rotating-cycle template ("what I SHOULD do"), distinct from the workouts
    // log above ("what I did"). Days/exercises/sets are embedded as an array,
    // like Diet's meals/items. Rules do not cascade from /users/{userId}, so explicit.
    match /users/{userId}/workoutPlans/{planId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.name is string
        && request.resource.data.status in ['active', 'archived']
        && request.resource.data.source in ['manual', 'pdf']
        && request.resource.data.schemaVersion == 1
        && request.resource.data.days is list
        && request.resource.data.cycleCursor is number;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Moments: each user reads/writes only their own moments. imagePath is a
    // local device path (Storage/photos are a later milestone), so no file rules here.
    match /users/{userId}/moments/{momentId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.caption is string
        && request.resource.data.takenAt is timestamp
        && request.resource.data.schemaVersion is int;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // University: each user reads/writes only their own assignments/exams.
    // Rules do not cascade from the parent /users/{userId} match, so explicit.
    match /users/{userId}/universityItems/{itemId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.title is string
        && request.resource.data.type is string
        && request.resource.data.done is bool
        && request.resource.data.schemaVersion is int;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Diet plans: each user reads/writes only their own plan(s) (days/meals/items
    // embedded, like Workout's exercises). Rules do not cascade from the parent
    // /users/{userId} match, so this is explicit.
    match /users/{userId}/dietPlans/{planId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.name is string
        && request.resource.data.status is string
        && request.resource.data.days is list
        && request.resource.data.schemaVersion is int;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Diet entries: the "did I eat this meal today" consumption log, one doc per
    // (day, meal). Rules do not cascade from the parent /users/{userId} match, so
    // this is explicit.
    match /users/{userId}/dietEntries/{entryId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.data.dayKey is string
        && request.resource.data.mealId is string
        && request.resource.data.eaten is bool
        && request.resource.data.schemaVersion is int;
    }

    // AI conversations: the user owns their chat threads. Client-writable
    // (create/rename); messages under them are server-written only (below).
    match /users/{userId}/aiConversations/{conversationId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.data.title is string
        && request.resource.data.schemaVersion is int;
    }

    // AI messages: written ONLY by the aiChat Cloud Function (Admin SDK bypasses
    // rules), so clients may READ their own thread but never write — a client
    // must not be able to forge an assistant/tool message.
    match /users/{userId}/aiConversations/{conversationId}/messages/{messageId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // AI pending actions (ADR-003 V2): proposed-but-unconfirmed writes, created
    // and mutated ONLY by the aiChat/aiConfirmAction/aiCancelAction Functions
    // (Admin SDK). A client may READ its own pending actions (to render the
    // confirmation card) but never write one — a forged pending action must not
    // be confirmable into a real write.
    match /users/{userId}/aiConversations/{conversationId}/pendingActions/{actionId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // AI usage/audit log: Functions-only, like emailOtps. Owner may read.
    match /users/{userId}/aiUsage/{usageId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Nothing else is exposed to clients. All eight feature repositories
    // (tasks, expenses, schedule, notes, workouts, moments, university, diet) are migrated,
    // plus the workout-plan store (workoutPlans — the "what I SHOULD do" template)
    // and the AI conversation store (aiConversations client-writable; messages/aiUsage
    // server-only).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
